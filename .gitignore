# Build output
target/
bin/
dependency-reduced-pom.xml

# Local data: never commit
# - every question asked, with who asked
audit.jsonl
# - "Correct" / "Wrong" feedback
feedback.jsonl
# - saved questions (they keep each run's last value, which is real data) and their alerts
*.saved.json
saved.json
alerts.jsonl
# - access-token fingerprints for the shared page
users.json
# - output of `querywarden grants`, holds a password once edited
grants.sql
# - secrets
.env
.env.*
# - local state: cached example questions, models chosen on the page, policy backups and change log
.querywarden/

# Temporary files
*.tmp
*.log

# Evaluation output: keep results, skip bulky or regenerated files
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
.claude/hillclimb/**/trajectory/

# Personal Claude Code settings
.claude/settings.local.json

# Editors and OS
.vscode/
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
.DS_Store
Thumbs.db
